TWILIO_AUTH_TOKEN=your_twilio_auth_token
OPEN_DIGITS=ww9
# Seconds to hold the relay socket open after the door tones are sent. Twilio
# plays them asynchronously, so ending the call at once truncates them and the
# door never trips. Only the voice-agent modes use this.
OPEN_DIGITS_SETTLE=3
RECORD_CALLS=true

# --- post-call SMS -----------------------------------------------------------
# After every completed call, text a summary to NOTIFY_SMS_TO. The Twilio REST
# client authenticates with TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN (above); the
# SMS is sent from the service's own Twilio number, read off each webhook, so
# there is no from-number here. Leave the first two blank to disable.
TWILIO_ACCOUNT_SID=
NOTIFY_SMS_TO=
# IANA zone for the timestamp in the text. Defaults to America/New_York, which
# renders EST/EDT correctly by date.
NOTIFY_TIMEZONE=America/New_York

# Call-handling mode: "auto" (open for everyone), "passcode", "voice-agent", or
# "voice-agent-people" (per-person question, with their own code to fall back on)
MODE=auto|passcode|voice-agent|voice-agent-people

# --- passcode mode -----------------------------------------------------------
# The valid passcode (numDigits is derived from its length). Required in
# passcode mode; ignored in the others.
PASSCODE=
PASSCODE_TIMEOUT=10

# Logs the raw DTMF digits Twilio decoded, to diagnose a panel that garbles or
# drops tones. Writes the passcode to the logs in plaintext: turn on for a test
# window only, then turn off and rotate PASSCODE.
DEBUG_DTMF=false

# --- voice-agent mode --------------------------------------------------------
# An LLM talks to the visitor and decides whether to open. Requires a one-time
# opt-in in the Twilio Console (see README) before ConversationRelay will work.
# Required in voice-agent mode.
ANTHROPIC_API_KEY=

# Cheapest and fastest tier; latency is what matters on a phone call.
AGENT_MODEL=claude-haiku-4-5

# Freeform facts about you, injected into the system prompt. This is what lets
# the agent tell a real visitor from a plausible-sounding one, so be specific.
# e.g. "Daniel lives in 4B. Expecting a plumber Tue afternoon. Amazon leaves
# packages in the lobby — they never need to be let in."
AGENT_CONTEXT=

# Spoken before the model is consulted, so the visitor hears something at once.
# In voice-agent-people mode this has to ask for a NAME — the first thing the
# visitor says is what gets matched against the roster.
AGENT_GREETING=Hello, who's there?

# Visitor turns before we give up and deny. Stops a caller talking their way in.
AGENT_MAX_TURNS=6

# Leave unset for Twilio's default voice. To use ElevenLabs, set both.
# AGENT_VOICE format: voiceId-model-speed_stability_similarity
# e.g. fBD19tfE58bkETeiwUoC-turbo_v2_5-0.9_0.7_0.8
AGENT_TTS_PROVIDER=
AGENT_VOICE=

# --- voice-agent-people mode -------------------------------------------------
# The roster: people we know by name, each with their own private questions and
# their own DTMF code (e.g. birth year). The visitor says a name, the model
# fuzzy-matches it, and ONE random question from that person's corpus is asked.
# Miss the question and they can enter their code instead. An unrecognized name
# is never offered a code — app.py texts you for a live YES/NO instead.
#
# Required in voice-agent-people mode. Contains door codes, so treat it the way
# you would treat a password file — in production it lives in Secret Manager.
# JSON, one object per person; "aliases" and "relation" are optional. First name
# alone is enough to match; last names are fine to add.
#
# AGENT_PEOPLE=[{"name":"Alex","relation":"brother","aliases":["Al"],"code":"1990","questions":[{"ask":"What was the name of the cat we grew up with?","answer":"Miso"}]}]
AGENT_PEOPLE=

# Tries at the fallback code before denying. Keep this low — the code is four
# digits, and a caller who can retry forever is running a brute-force.
AGENT_CODE_ATTEMPTS=1

# Seconds to wait for the NEXT digit before giving up on a half-entered code.
# Twilio sends one frame per keypress and never signals completion, so this is
# what ends a code that was started and abandoned.
AGENT_CODE_TIMEOUT=10

# Seconds to keep the call open waiting for your YES/NO text when an unknown
# visitor buzzes. Past this we deny. Requires the Twilio number's messaging
# webhook to point at POST /sms, and Cloud Run --max-instances=1 so the
# WebSocket and the SMS land on the same process.
AGENT_APPROVAL_TIMEOUT=60

# Guards the /relay WebSocket, which Twilio does not sign. Auto-generated per
# process when unset — set it explicitly if you run more than one instance.
RELAY_SECRET=
